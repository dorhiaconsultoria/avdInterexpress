# Copie para .env (ou configure no painel do servidor) e ajuste os valores.

# Endereço público do sistema (usado nos links dos e-mails). No Vercel é opcional.
APP_URL=https://competencias.interexpress.com.br
PORT=3000

# Banco Postgres. No Vercel é criado pela integração com o Neon (Storage), que preenche esta variável.
# Sem ela, o sistema usa um Postgres embutido gravado em DATA_DIR/pgdata (bom para testar no computador).
DATABASE_URL=
DATA_DIR=./data

# Opcional: protege a rota dos lembretes automáticos chamada pelo Cron Jobs do Vercel
CRON_SECRET=

# Senha inicial da administradora (troca obrigatória no primeiro acesso)
ADMIN_SENHA_INICIAL=Teste@2026

# Servidor de e-mail (só é usado depois de "Colocar no ar")
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nao-responda@interexpress.com.br
SMTP_PASS=
SMTP_FROM=InterExpress — Verificação de Competências <nao-responda@interexpress.com.br>
